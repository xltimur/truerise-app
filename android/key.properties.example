# TrueRise / Rectify - Android signing template
# ---------------------------------------------------------------------------
# This file is a TEMPLATE. It is committed to Git. Copy it to
# `android/key.properties` (which is git-ignored) and fill it with the
# values for your local upload keystore:
#
#   cp android/key.properties.example android/key.properties
#
# The real `android/key.properties` and the `.jks` / `.keystore` file it
# points to MUST NEVER be committed. They contain credentials that can sign
# releases under this app's identity. They are excluded by `android/.gitignore`.
#
# `android/app/build.gradle.kts` reads this file to sign release builds.
# Release tasks (e.g. `flutter build apk` / `flutter build appbundle`)
# FAIL with an actionable error when this file is missing, incomplete, or
# points at a keystore that does not exist - there is no debug-signing
# fallback. Debug builds (`flutter run`) do not need this file.
#
# Generating a local upload keystore (the real Play upload keystore is
# held by the release owner in a password manager / secret store, NOT in
# the repo; Google Play App Signing requires its own enrollment flow):
#
#   keytool -genkey -v \
#     -keystore ~/.android/truerise-upload.jks \
#     -alias upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# See https://flutter.dev/to/reference-keystore for the canonical Flutter
# signing flow.
# ---------------------------------------------------------------------------

# Password of the keystore file.
storePassword=CHANGE_ME

# Password of the key alias inside the keystore.
keyPassword=CHANGE_ME

# Alias of the signing key inside the keystore.
keyAlias=upload

# Path to the .jks/.keystore file. Absolute paths and paths relative to the
# `android/` directory are both accepted.
# Keep the keystore OUTSIDE the repo (e.g. ~/.android/truerise-upload.jks).
storeFile=/absolute/path/to/your/truerise-upload.jks
