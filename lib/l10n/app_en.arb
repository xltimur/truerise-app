  "privacyApiKeyTitle": "Optional API key",
  "@privacyApiKeyTitle": {
    "description": "Privacy section heading about the optional user-supplied API key."
  },
  "privacyApiKeyBody": "Power users can paste their own provider API key in Settings. When set, that key lives in the platform keychain (iOS) or Keystore (Android) — it never enters the database, preferences, logs, or crash reports, and is never displayed back to you after you save it.",
  "@privacyApiKeyBody": {
    "description": "Privacy section body about where the optional API key is stored."
