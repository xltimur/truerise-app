# Demo-build environment for TrueRise / Rectify.
# Loaded by lib/main.dart via flutter_dotenv from the bundled
# .env asset (pubspec.yaml -> flutter.assets). The in-app
# Settings -> API Key entry (flutter_secure_storage) always
# overrides this value at runtime. Do NOT commit additional
# secrets here for production builds.
ASTRO_API_KEY=
